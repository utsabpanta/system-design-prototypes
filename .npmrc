# CDK's NodejsFunction shells out to esbuild and resolves aws-cdk-lib's own
# transitive deps at synth time, which pnpm's default symlinked layout hides.
# A hoisted node_modules keeps the CDK toolchain working exactly as it does
# under npm, at the cost of pnpm's strictness — worth it for an IaC repo.
node-linker=hoisted
