{
  "name": "system-design-prototypes",
  "version": "0.1.0",
  "private": true,
  "description": "Cell-based multi-tenant architecture prototype running on LocalStack",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "up": "docker compose up -d && bash tools/wait-for-localstack.sh",
    "down": "docker compose down",
    "reset": "docker compose down -v && rm -rf .localstack cdk.out && pnpm run up",
    "smoke": "bash tools/smoke.sh",
    "synth": "bash tools/with-local-env.sh cdklocal synth --quiet",
    "bootstrap": "bash tools/with-local-env.sh cdklocal bootstrap",
    "deploy": "bash tools/with-local-env.sh cdklocal deploy --all --require-approval never --concurrency 4",
    "deploy:cell": "bash tools/with-local-env.sh cdklocal deploy --require-approval never",
    "destroy": "bash tools/with-local-env.sh cdklocal destroy --all --force",
    "seed": "bash tools/with-local-env.sh tsx tools/seed.ts",
    "urls": "bash tools/with-local-env.sh tsx tools/urls.ts",
    "tenant": "bash tools/with-local-env.sh tsx tools/tenant.ts",
    "chaos": "bash tools/with-local-env.sh tsx tools/chaos.ts",
    "load": "bash tools/with-local-env.sh tsx tools/loadgen.ts",
    "migrate": "bash tools/with-local-env.sh tsx tools/migrate.ts",
    "dash": "bash tools/with-local-env.sh tsx tools/dashboard-server.ts",
    "test": "bash tools/with-local-env.sh vitest run",
    "test:slow": "bash tools/with-local-env.sh vitest run --exclude '**/node_modules/**' test/integration/dlq.slow.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.2",
    "aws-cdk": "^2.1133.0",
    "aws-cdk-local": "^3.0.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1096.0",
    "@aws-sdk/client-sfn": "^3.1096.0",
    "@aws-sdk/client-sqs": "^3.1096.0",
    "@aws-sdk/client-ssm": "^3.1096.0",
    "@aws-sdk/client-sts": "^3.1096.0",
    "@aws-sdk/lib-dynamodb": "^3.1096.0",
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.7.1"
  }
}
